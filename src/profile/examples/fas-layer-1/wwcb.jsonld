  "externalDeps": [
    "BeautifulSoup4",
    "requests",
    "fitz (PyMuPDF)",
    "GCP Vision OCR",
    "pycountry"
  ],
  "connectorSteps": [
    "C1 BeautifulSoup scrape esmis.nal.usda.gov index",
    "C2 collect PDF bulletin links + <time datetime>",
    "C3 delta via utils.get_repo_ids",
    "C4 utils.parse_bulletin splits USA + International summary + per-country page slices",
    "C5 per-country child jobs keyed by figure page",
    "C6 image OCR via utils.run_image (12500B size gate)",
    "C7 copy release_date to children + build link graph"
  ],

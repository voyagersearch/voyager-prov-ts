  "sourceUrl": "https://ipad.fas.usda.gov/monitormaps/FloodMonitor and .../CycloneMonitor",
  "externalDeps": [
    "BeautifulSoup4",
    "GCP Vision OCR"
  ],
  "connectorSteps": [
    "C1 scrape flood regions + cyclone oceans/storms",
    "C2 download PNG per event",
    "C3 utils.run_image OCR",
    "C4 parse 'Sources:' from OCR text \u2192 fss_sources[]",
    "C5 utils.download_image \u2192 path_to_thumb",
    "C6 sets grp_data_location_type='Geospatial Data' + grp_geospatial_data='Monitor Maps' (in connector)"
  ],

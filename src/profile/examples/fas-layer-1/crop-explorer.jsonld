{
  "@context": {
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "voyager": "urn:voyager:prov:"
  },
  "fasSource": "crop-explorer",
  "fasSourceName": "Crop Explorer (weather/vegetation maps)",
  "hadPrimarySource": {
    "@id": "https://docs.google.com/presentation/d/1IybpPfUqDYji0ge-X0n165gMV8pU2UqlZQFKxIykk5k",
    "deckSlides": "26"
  },
  "sourceUrl": "https://ipadinternalportal.fas.usda.gov/cropexplorer/imageview.aspx?regionid={id}",
  "externalDeps": [
    "urllib",
    "BeautifulSoup4",
    "Voyager placefinder Solr"
  ],
  "connectorSteps": [
    "C1 per-region scrape (utils.regions_info)",
    "C2 find <li class='ceMenu'> items filtered to Precipitation/Temperature/Soil Moisture/Drought Severity/Vegetation Index",
    "C3 urlparse startdate/imenddate",
    "C4 fetch page, find img.coords = map image URL",
    "C5 utils.download_image \u2192 path_to_thumb + hasThumb",
    "C6 placefinder geo lookup by region country \u2192 spatial.shape",
    "C7 sets grp_data_location_type='Geospatial Data' (in connector)"
  ],

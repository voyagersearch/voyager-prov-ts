  },
  "fasSource": "commodity-explorer",
  "fasSourceName": "Commodity Explorer (country \u00d7 commodity \u00d7 rank)",
  "hadPrimarySource": {
    "@id": "https://docs.google.com/presentation/d/1IybpPfUqDYji0ge-X0n165gMV8pU2UqlZQFKxIykk5k",
    "deckSlides": "25"
  },
  "sourceUrl": "https://ipadinternalportal.fas.usda.gov/cropview/commodityView.aspx?cropid={code}&rankby={type}&startrow={n}",
  "externalDeps": [
    "BeautifulSoup4",
    "Voyager placefinder Solr"
  ],
  "connectorSteps": [
    "C1 triple loop rank_type \u00d7 12 commodities \u00d7 startrow (1,11,21,31)",
    "C2 BS4 scrape rank table",
    "C3 grouper() zip production/percent/rank triples with country rows",
    "C4 top-state list from subRegionList (Production only)",
    "C5 download crop_map image \u2192 path_to_thumb + hasThumb",
    "C6 placefinder geo \u2192 spatial.shape",
    "C7 sets grp_data_location_type='Geospatial Data' (in connector)"
  ],

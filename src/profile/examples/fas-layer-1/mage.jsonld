{
  "@context": {
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "voyager": "urn:voyager:prov:"
  },
  "fasSource": "mage",
  "fasSourceName": "MAGE (Mobile Awareness GEOINT Environment, crop-tour observations)",
  "hadPrimarySource": {
    "@id": "https://docs.google.com/presentation/d/1IybpPfUqDYji0ge-X0n165gMV8pU2UqlZQFKxIykk5k",
    "deckSlides": "29"
  },
  "sourceUrl": "https://usda.mage.geointapps.com/api/events/{id}/observations",
  "externalDeps": [
    "requests"
  ],
  "connectorSteps": [
    "C1 login POST /auth/local/signin + device token POST /auth/token",
    "C2 iterate events GET /api/events \u2192 per-event GET /api/events/{id}/observations?populate=true&states=active",
    "C3 per-observation extract first `form` \u2192 map values against in-file enums: land_covers, crop_conditions, crop_stages, observed_health_conditions, soil_conditions, water_supplies, comments",
    "C4 download first attachment \u2192 make_thumbnail (E:/voyager/voyager_data/meta/{repo}/thumb/...)",
    "C5 attach event context (name/description) + GeoJSON geo pass-through",
    "C6 sets grp_data_location_type='Geospatial Data' (in connector)"
  ],
